# Copy to infra/.env (ignored by git) and fill in. Use letters and digits only in
# passwords: they go inside a connection URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
APP_DB_PASSWORD=
# File name of the service account key inside ~/.config/craftech-os/secrets/
# (for example gcp-finance-bot-ingest.json). Mounted read-only into the app container.
GOOGLE_SA_KEY_FILE=
