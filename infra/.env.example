# Copy to infra/.env (ignored by git) and fill in. Use letters and digits only in
# passwords: they go inside a connection URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
APP_DB_PASSWORD=
# The two PostgreSQL users of the MCP server (Claude Desktop): one reads, one only inserts.
MCP_READER_PASSWORD=
MCP_WRITER_PASSWORD=
# File name of the service account key inside ~/.config/craftech-os/secrets/
# (for example gcp-finance-bot-ingest.json). Mounted read-only into the app container.
GOOGLE_SA_KEY_FILE=
# Absolute path of the folder for the daily pg_dump files (the last 14 are kept).
# Empty means ~/.config/craftech-os/backups. Create it before `docker compose up`.
BACKUPS_DIR=
